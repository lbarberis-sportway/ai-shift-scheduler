# Configurazione Database PostgreSQL (Supabase o Vercel Postgres)
# Inserisci qua sotto il link che hai copiato da Supabase per connettere il database al tuo ambiente locale.
# Su Vercel.com, dovrai aggiungere questa stessa variabile su "Settings > Environment Variables".
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Altri parametri (se futuri)
